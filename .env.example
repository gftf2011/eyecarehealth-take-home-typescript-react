# Dois usos:
# - backend/.env: lido pelos scripts do backend fora do Docker (npm run dev,
#   seed…). Copie este arquivo para lá e ajuste.
# - .env na raiz: lido pelo docker-compose.yml para trocar os padrões de
#   desenvolvimento (senhas do Postgres, segredos JWT, COOKIE_SECURE,
#   TRUST_PROXY, portas). As URLs de banco e Redis do Docker são montadas
#   pelo próprio compose.

# Banco de Dados
DATABASE_URL=postgresql://fastmeals:fastmeals123@localhost:5432/fastmeals
POSTGRES_USER=fastmeals
POSTGRES_PASSWORD=fastmeals123
POSTGRES_DB=fastmeals

# Redis (rate limit, tentativas de login e fan-out do tempo real entre réplicas)
REDIS_URL=redis://localhost:6379

# JWT — segredos com 32+ caracteres e diferentes entre si
JWT_SECRET=troque-por-um-segredo-de-acesso-com-32-ou-mais-chars
JWT_REFRESH_SECRET=troque-por-um-segredo-de-refresh-com-32-ou-mais-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_COST=10

# API
PORT=3001
NODE_ENV=development
# false só em desenvolvimento sem HTTPS (cookie do refresh token sem Secure)
COOKIE_SECURE=false
# Proxies confiáveis para o IP real (rate limit): IPs/CIDRs ou nº de saltos; vazio = nenhum
TRUST_PROXY=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=60000

# Mensageria (SNS/SQS). Em desenvolvimento, o Floci do docker-compose
# (docker compose up floci messaging-setup); sem AWS_ENDPOINT_URL, a AWS real.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENTS_TOPIC_NAME=fastmeals-events.fifo
EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:fastmeals-events.fifo
REALTIME_QUEUE_NAME=fastmeals-realtime.fifo
REALTIME_DLQ_NAME=fastmeals-realtime-dlq.fifo
# Recebimentos sem sucesso até a mensagem ir para a fila morta do SQS
REALTIME_MAX_RECEIVE_COUNT=5
REALTIME_VISIBILITY_TIMEOUT_SECONDS=30

# Outbox relay (worker)
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
# Falhas permanentes de uma mensagem até ela ir para a fila morta
OUTBOX_MAX_ATTEMPTS=5
RELAY_HEALTH_PORT=3003

# Gateway de tempo real (WebSocket)
REALTIME_PORT=3002
REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:3001/api
VITE_REALTIME_URL=ws://localhost:3002/realtime
