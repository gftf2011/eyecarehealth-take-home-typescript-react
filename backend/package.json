{
  "name": "fastmeals-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main/server.ts",
    "dev:relay": "tsx watch --env-file-if-exists=.env src/main/outbox-relay.ts",
    "dev:realtime": "tsx watch --env-file-if-exists=.env src/main/realtime-gateway.ts",
    "docker:up": "docker compose up --build --detach --wait && docker compose ps",
    "docker:logs": "docker compose logs --follow api outbox-relay realtime",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down --volumes && npm run docker:up",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:relay": "node --env-file-if-exists=.env dist/outbox-relay.js",
    "start:realtime": "node --env-file-if-exists=.env dist/realtime-gateway.js",
    "typecheck": "tsc --noEmit",
    "migrate:latest": "tsx --env-file-if-exists=.env src/main/database/migrate.ts latest",
    "migrate:down": "tsx --env-file-if-exists=.env src/main/database/migrate.ts down",
    "seed": "tsx --env-file-if-exists=.env src/main/seed/seed.ts",
    "start:seed": "node --env-file-if-exists=.env dist/seed.js",
    "start:migrate": "node --env-file-if-exists=.env dist/migrate.js latest",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:architecture": "vitest run --project architecture",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "archunit": "^2.5.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "@node-rs/bcrypt": "^2.0.0",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "plantuml-parser": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  }
}
