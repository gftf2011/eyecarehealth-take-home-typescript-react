# Template do nginx (as variáveis ${...} são preenchidas no boot pelo
# entrypoint da imagem; variáveis do nginx, como $host, ficam intactas).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # DNS interno do Docker, revalidado: se a API reiniciar com outro IP, o
    # proxy acompanha (proxy_pass com variável resolve a cada requisição).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};
    set $realtime_upstream http://${REALTIME_UPSTREAM};

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API na mesma origem: o cookie do refresh token (SameSite=Strict,
    # Path=/api/auth) funciona sem CORS. A API confia só neste proxy para
    # ler o IP real do cliente (rate limit por IP).
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # WebSocket do painel em tempo real. O Origin do navegador segue
    # intacto: o gateway confere a allowlist de origens.
    location = /realtime {
        proxy_pass $realtime_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Arquivos com hash no nome: cache longo e imutável.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # SPA: qualquer rota do painel (/pedidos, /relatorios...) abre o index.html,
    # sempre revalidado para um deploy novo valer na hora.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
