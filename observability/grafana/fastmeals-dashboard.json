          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fastmeals_http_server_request_duration_milliseconds_bucket{http_route!~\"/api/health|/health\"}[$__rate_interval])))",
